<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card of the main screen: soft blue glow fading into the page background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/hero_start"
        android:centerColor="@color/surface"
        android:endColor="@color/hero_end"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#334F8CFF" />
</shape>
